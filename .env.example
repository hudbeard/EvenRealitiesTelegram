# Copy to .env. Never paste a bot token into chat or commit .env.
# Demo mode is isolated: no Telegram calls, all messages are synthetic.
FIELDLINE_MODE=demo
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:3001
# Base path: mode is appended, so demo and real data never share a database.
DATABASE_PATH=.data/fieldline
OPERATOR_LABEL=Crew member

# For live mode, set FIELDLINE_MODE=telegram and all three values below.
# Obtain the bot token from Telegram @BotFather yourself.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (the person wearing the glasses).
TELEGRAM_OPERATOR_ID=
# One consenting test group's numeric chat ID, often negative.
TELEGRAM_CHAT_ID=

