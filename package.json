{
  "name": "fieldline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "simulate": "node .tooling/node_modules/@evenrealities/evenhub-simulator/bin/index.js http://127.0.0.1:3001 --automation-port 9898",
    "pack": "node scripts/pack.mjs",
    "test:simulator": "node scripts/simulator-smoke.mjs",
    "telegram:check": "node scripts/check-telegram.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "dotenv": "18.0.10",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
